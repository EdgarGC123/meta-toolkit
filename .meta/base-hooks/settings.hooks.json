{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "description": "Hooks layer — merge on top of settings.template.json when hooks are enabled. See .meta/base-hooks/README.md for generator wiring instructions.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh",
            "args": [],
            "timeout": 30,
            "statusMessage": "Loading project context..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-close-check.sh",
            "args": [],
            "timeout": 10,
            "statusMessage": "Checking session close conditions..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(rm *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-destructive.sh",
            "args": []
          }
        ]
      }
    ]
  }
}
