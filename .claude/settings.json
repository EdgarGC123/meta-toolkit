{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "description": "Generator project settings \u2014 committed with the repo. Grants permissions needed to run /start-here, including git detach on generation.",
  "permissions": {
    "allow": [
      "Read(/**)",
      "Read(//**)",
      "Edit(/**)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(cat *)",
      "Bash(stat *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(rm *)",
      "Bash(rm -f *)",
      "Bash(rm -rf *)",
      "Bash(mkdir *)",
      "Bash(mkdir -p *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git remote*)",
      "Bash(git remote remove *)",
      "Bash(git rev-parse*)",
      "Bash(git init*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git *)",
      "Bash(gh api *)",
      "Bash(gh search *)",
      "Bash(curl *)",
      "Bash(pwd*)",
      "Bash(chmod *)",
      "Skill(claude-api)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:platform.claude.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:stackoverflow.com)",
      "WebFetch(domain:stackoverflow.blog)",
      "WebFetch(domain:www.anthropic.com)",
      "WebFetch(domain:simonwillison.net)",
      "WebFetch(domain:martinfowler.com)",
      "WebFetch(domain:harper.blog)",
      "WebFetch(domain:kentcdodds.com)",
      "WebFetch(domain:www.promptingguide.ai)",
      "WebFetch(domain:www.infoq.com)",
      "WebFetch(domain:www.thoughtworks.com)",
      "WebFetch(domain:newsletter.pragmaticengineer.com)",
      "WebFetch(domain:posthog.com)",
      "WebFetch(domain:en.wikipedia.org)",
      "WebFetch(domain:arxiv.org)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:githubnext.com)",
      "WebFetch(domain:github.blog)",
      "WebFetch(domain:cursor.com)",
      "WebFetch(domain:www.cursor.com)",
      "WebFetch(domain:docs.cursor.com)",
      "WebFetch(domain:docs.devin.ai)",
      "WebFetch(domain:www.builder.io)",
      "WebFetch(domain:www.pluralsight.com)",
      "WebFetch(domain:www.legacycode.rocks)",
      "WebFetch(domain:www.mckinsey.com)",
      "WebFetch(domain:www.hbr.org)",
      "WebFetch(domain:www.lenny.fyi)",
      "WebFetch(domain:www.lennysnewsletter.com)",
      "WebFetch(domain:www.reddit.com)",
      "WebFetch(domain:x.com)",
      "WebFetch(domain:www.warp.dev)",
      "WebFetch(domain:unix.stackexchange.com)",
      "WebFetch(domain:www.mankier.com)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf /System*)",
      "Bash(rm -rf /Library*)"
    ],
    "defaultMode": "acceptEdits"
  }
}